{
 "_contract": {
  "name": "Asasly recording list",
  "version": 1,
  "agreed": "2026-10-07 (App and Content chat, with Tamer)",
  "producer": "the Asset Office exports it; it is published as one file next to the recording page, which reads it each time it opens; an update replaces this file only",
  "which_words": "Fusha and colloquial alike: every word whose machine voices were all rejected, and every word whose approved human take was made for an older text. A word whose voices still await judgment stays out until judged.",
  "fields": {
   "contract": "the contract version (1)",
   "made_at": "when the office exported the list (ISO 8601 with offset)",
   "sample": "true only in a sample like this one",
   "check": "the thresholds of the office's automatic check (dB relative to full scale, seconds), for the page's live warnings",
   "fingerprint_rule": "how a fingerprint is computed, for verification only: the page copies fingerprints, it never computes them",
   "words[].id": "the word's id; the take's file name in the session zip is <id>.<ext>",
   "words[].text": "the exact text of the spoken list (content.json), character for character: shown to the speaker as it is (it is the vowelled form) and the basis of the fingerprint. Never normalize it (no NFC/NFD): a shadda followed by a vowel would be reordered and the fingerprint would change",
   "words[].fingerprint": "computed by the office; copied untouched into session.json recordings[].fingerprint",
   "words[].register": "'dialect' or 'fusha': the page's instruction line (read it in your daily dialect / read it in Fusha)",
   "words[].dialect": "'eg' for Egyptian colloquial, '' for Fusha",
   "words[].roman": "the romanization, standard scheme, from the project's romanizer (tools/roman.py)",
   "words[].fusha": "the Fusha counterpart shown beside a colloquial word; null for a Fusha word",
   "words[].order": "the position in the lessons (1 = first); the page records in this order; words not in any lesson yet come last",
   "words[].lesson": "{id, number, title} of the first lesson that teaches the word, or null",
   "words[].redo": "present only when an earlier human take was rejected: {reason, note}, shown to the speaker"
  },
  "saving": "the page keeps the speaker's takes by id AND fingerprint: when a new list changes a word's fingerprint, its saved take is stale and is recorded again",
  "session_file": "unchanged (the office's session contract): session.json {speaker, recorded_at, consent, recordings:[{id, file, fingerprint}]} + <id>.<ext>; consent carries the consent text the speaker accepted"
 },
 "contract": 1,
